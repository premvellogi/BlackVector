{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VQA Request/Response Contract",
  "description": "Contract for the /vqa endpoint (F1 - Mandatory)",
  "definitions": {
    "VQARequest": {
      "type": "object",
      "required": ["image", "question"],
      "properties": {
        "image": {
          "type": "string",
          "format": "binary",
          "description": "Single satellite image (GeoTIFF/TIFF primary, PNG/JPEG for benchmarks)"
        },
        "question": {
          "type": "string",
          "description": "Natural language question about the image"
        }
      }
    },
    "VQAResponse": {
      "type": "object",
      "required": ["answer", "confidence", "provenance"],
      "properties": {
        "answer": { "type": "string" },
        "confidence": { "$ref": "#/definitions/Confidence" },
        "evidence_regions": {
          "type": "array",
          "items": { "$ref": "#/definitions/BoundingBox" }
        },
        "provenance": { "$ref": "#/definitions/Provenance" },
        "execution_time_ms": { "type": "number" }
      }
    },
    "Confidence": {
      "type": "object",
      "required": ["score"],
      "properties": {
        "score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "method": { "type": "string" },
        "factors": { "type": "object" }
      }
    },
    "BoundingBox": {
      "type": "object",
      "required": ["x_min", "y_min", "x_max", "y_max"],
      "properties": {
        "x_min": { "type": "number" },
        "y_min": { "type": "number" },
        "x_max": { "type": "number" },
        "y_max": { "type": "number" },
        "label": { "type": "string" },
        "confidence": { "type": "number" }
      }
    },
    "Provenance": {
      "type": "object",
      "required": ["model_name"],
      "properties": {
        "model_name": { "type": "string" },
        "checkpoint_version": { "type": "string" },
        "input_hash": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "preprocessing": { "type": "object" }
      }
    }
  }
}
